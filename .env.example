# Copy to .env and edit. Every setting is optional.

# Port for the API (and the built app with `npm start`).
# PORT=3002

# 127.0.0.1 = this computer only (default).
# 0.0.0.0   = also phones and laptops on the home network. See docs/DESIGN.md §9:
#             allow Node through Windows Firewall on Private networks only.
# HOST=0.0.0.0

# Extra host names allowed in the Host header, comma-separated (e.g. a name your
# router assigns like "dadlaptop.lan"). localhost, private IPs, and this
# computer's name are always allowed.
# ALLOWED_HOSTS=

# DATA_DIR=./data

# Claude API key: turns on "Import from a website" on the New recipe page
# (docs/DESIGN.md §6). Get one at https://platform.claude.com. Stays on this
# computer; the browser never sees it. Each import costs a few cents.
# ANTHROPIC_API_KEY=
