{
  "name": "meal-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Locally hosted recipe keeper, weekly meal planner, and combined grocery list",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev -w @meal-planner/api\" \"npm:dev -w @meal-planner/web\"",
    "build": "npm run build -w @meal-planner/web && npm run build -w @meal-planner/api",
    "start": "npm run start -w @meal-planner/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @meal-planner/api --",
    "db:migrate": "npm run db:migrate -w @meal-planner/api",
    "db:seed": "npm run db:seed -w @meal-planner/api --",
    "db:studio": "npm run db:studio -w @meal-planner/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
